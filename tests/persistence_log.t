use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use File::Spec::Functions qw(catfile);
require './LastFmGuidance/PersistenceLog.pm';

my $dir = tempdir(CLEANUP => 1);
my $path = catfile($dir, 'error-123-456.json');
open my $out, '>:raw', $path or die $!;
print {$out} '{"error":"database is locked"}';
close $out;
my @logs;
Plugins::LastFmGuidance::PersistenceLog::drain($dir, sub { push @logs, shift });
is_deeply(\@logs, ['Last.fm background persistence failed: database is locked'],
    'background database failure reaches the provider logger');
Plugins::LastFmGuidance::PersistenceLog::drain($dir, sub { push @logs, shift });
is(scalar @logs, 1, 'a handled failure is logged once');
my $info = catfile($dir, 'info-123-457.json');
open my $info_out, '>:raw', $info or die $!;
print {$info_out} '{"artist":"Faun","returned":100,"stored":23,"excluded_non_library":77}';
close $info_out;
my @info_logs;
Plugins::LastFmGuidance::PersistenceLog::drain($dir, sub { push @logs, shift }, sub { push @info_logs, shift });
is_deeply(\@info_logs, ['Last.fm: stored 23 of 100 similar artists for "Faun" (77 excluded: not in Lyrion library)'], 'successful local-only persistence is logged with the actual counts');
ok(!-e $info, 'success report is consumed once');
my $budget = catfile($dir, 'error-123-458.json');
open my $budget_out, '>:raw', $budget or die $!;
print {$budget_out} '{"error":"Last.fm artist result exceeded the configured storage limit"}';
close $budget_out;
Plugins::LastFmGuidance::PersistenceLog::drain($dir, sub { push @logs, shift }, sub { push @info_logs, shift });
like($logs[-1], qr/exceeded the configured storage limit/, 'rejected writes are logged with their reason');
ok(Plugins::LastFmGuidance::PersistenceLog::last_budget_rejection($dir), 'a rejected background write remains visible on the settings page after log consumption');
done_testing();
